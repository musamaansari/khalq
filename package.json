{
  "name": "khalq",
  "version": "1.0.0",
  "description": "Khalq — software, AI and automation built around your ideas.",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "notifications": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/notifications.ts",
    "lint": "eslint .",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "notifications:worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/notifications.ts --loop",
    "db:import": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/import-sqlite.ts",
    "qa": "node scripts/qa-production.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musamaansari/khalq.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/musamaansari/khalq/issues"
  },
  "homepage": "https://github.com/musamaansari/khalq#readme",
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "libphonenumber-js": "^1.13.13",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
