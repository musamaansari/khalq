# Node 24+, single server with a persistent private disk.
SITE_URL=http://localhost:3000
DATABASE_PATH=./data/khalq.sqlite
# Generate a long random value before production.
RATE_LIMIT_SECRET=
# Set only if your reverse proxy OVERWRITES this header and blocks direct access.
# Example: x-real-ip. Without it, rate limits are shared by all visitors.
TRUSTED_IP_HEADER=
# Private webhook for your email/CRM automation; queued until configured.
LEAD_NOTIFICATION_WEBHOOK=
LEAD_NOTIFICATION_TOKEN=
