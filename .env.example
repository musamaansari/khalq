# PUBLIC DISPLAY VALUES (read on the server; deliberately no NEXT_PUBLIC_* variables)
APP_URL=http://localhost:3000
# Optional real public contact/legal identity. Never use notification recipients automatically.
CONTACT_EMAIL=
LEGAL_ENTITY_NAME=

# SERVER ONLY — do not commit configured .env files or expose any of these in browser bundles.
# NODE_ENV is set by Next.js; scripts/start.ts defaults it to production.
# APP_ENV=local permits a local production-build preview ONLY with a localhost APP_URL,
# and is rejected as a bypass on Railway. Omit APP_ENV in Railway production.
APP_ENV=local

# Local: leave DATABASE_URL blank to use SQLite. Production: PostgreSQL is mandatory.
DATABASE_URL=
DATABASE_PATH=./data/khalq.sqlite
# PostgreSQL URL uses the private Railway service reference in production.
# For public PostgreSQL connections, use verified TLS (sslmode=verify-full).

# Both required in production: distinct random values of at least 32 characters.
RATE_LIMIT_SECRET=
ATTRIBUTION_SECRET=
# Configure only AFTER verifying that the deployment edge overwrites/appends the trusted header.
TRUST_PROXY=false
TRUSTED_IP_HEADER=
# The trusted client entry counted from the RIGHT of the configured comma-separated chain.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
SPAM_MIN_FORM_MS=2000

# disabled is allowed locally only. Production choices: resend, gmail, or existing webhook.
EMAIL_PROVIDER=disabled
NOTIFICATION_EMAIL=
EMAIL_FROM=
EMAIL_API_KEY=
# Gmail/Google Workspace: OAuth client and refresh token; never a personal account password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional legacy internal integration, used only with EMAIL_PROVIDER=webhook.
LEAD_NOTIFICATION_WEBHOOK=
LEAD_NOTIFICATION_TOKEN=

# Minimal first-party analytics. No advertising tags or third-party analytics SDK.
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# Maintenance only; not needed on the running app.
SQLITE_IMPORT_PATH=
# CI / integration tests ONLY; never set this to a production database.
TEST_DATABASE_URL=
# Railway injects PORT; locally the default is 3000.
